# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
# Stores metadata only (media records, folders, page-image overrides).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/saasX?retryWrites=true&w=majority
# DNS servers used for mongodb+srv lookups (fixes querySrv ECONNREFUSED behind VPN/WARP).
DNS_SERVERS=1.1.1.1,8.8.8.8

# ─── Auth ─────────────────────────────────────────────────
# Signs admin session tokens. Changing it signs everyone out.
JWT_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=7d

# Developer account (full access) created/updated by `npm run seed` (re-run after changing).
ADMIN_EMAIL=admin@saasx.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=SaaX Admin

# ─── Email & links ────────────────────────────────────────
# Public URL of the Next.js app, used in invitation and password-reset emails.
APP_URL=http://localhost:3000
# Optional: key that encrypts the SMTP app password in MongoDB (defaults to one derived
# from JWT_SECRET; if you change either, re-enter the app password in Admin → Email).
# SETTINGS_SECRET=
# SMTP itself (host, user, app password…) is configured in the admin: Email (SMTP).

# ─── Projects ─────────────────────────────────────────────
# Imported into MongoDB on first start when there are no projects yet.
PROJECTS_SEED_FILE=../Saas/src/data/project-content.json

# ─── CORS ─────────────────────────────────────────────────
# The Next.js app proxies /api, so this only matters for direct API calls.
CORS_ORIGINS=http://localhost:3000

# ─── Uploads ──────────────────────────────────────────────
# All images are local files in the frontend public folder, served by Next.js at /uploads/... .
UPLOAD_DIR=../Saas/public/uploads
MAX_UPLOAD_MB=25
# Uploads are optimised to WebP at this quality, up to this many px on the longest edge (never upscaled).
MAX_IMAGE_DIMENSION=3840
IMAGE_QUALITY=90
